{
  "name": "personal-website-tomphie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests/paths.test.ts tests/navigation.test.ts tests/deployment.test.ts tests/route-progress.test.ts tests/brand-layout.test.ts tests/theme.test.ts tests/logo-theme-source.test.ts",
    "test:dist": "vitest run tests/build-output.test.ts",
    "test:watch": "vitest",
    "verify": "npm run test:unit && npm run check && npm run build && npm run test:dist"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.13.4",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
