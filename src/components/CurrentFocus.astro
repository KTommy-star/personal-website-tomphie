---
import { profile } from "../data/profile";
import BrandWord from "./BrandWord.astro";
---

<section class="brand-scene focus-section relative overflow-hidden bg-ink py-20 text-paper sm:py-24 lg:py-28" aria-labelledby="focus-title">
  <BrandWord placement="focus" />

  <div class="relative z-10 mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(24rem,1.1fr)] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <h2 id="focus-title" class="text-balance text-4xl font-semibold leading-[1.12] sm:text-5xl lg:text-6xl">
          <span class="block">在广度里探索</span>
          <span class="block">也在深度里求索</span>
        </h2>
        <p class="mt-7 max-w-lg text-pretty text-lg leading-8 text-paper/70">
          <span class="block">对新的方向保持好奇</span>
          <span class="block">对真正的问题保持耐心</span>
        </p>

        <ul class="role-list mt-10 border-t border-paper/20 text-sm text-paper/72" role="list">
          {profile.roles.map((role) => <li class="border-b border-paper/20 py-3">{role}</li>)}
        </ul>
      </div>

      <div>
        <p class="mb-4 text-sm text-paper/60">正在关注的研究方向</p>
        <ul class="border-t border-paper/20" role="list">
          {profile.focuses.map((item) => (
            <li class="focus-item border-b border-paper/20 py-6 text-2xl font-semibold sm:py-7 sm:text-4xl">
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .focus-item {
    transition:
      color 180ms ease-out,
      transform 180ms ease-out;
  }

  @media (hover: hover) {
    .focus-item:hover {
      color: var(--color-path);
      transform: translateX(0.5rem);
    }
  }

  @supports (animation-timeline: view()) {
    .focus-item {
      animation: focus-enter linear both;
      animation-range: entry 0% entry 35%;
      animation-timeline: view();
    }
  }

  @keyframes focus-enter {
    from {
      opacity: 0.35;
    }

    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .focus-item {
      animation: none;
    }
  }
</style>
