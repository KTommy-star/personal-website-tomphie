---
import { Picture } from "astro:assets";
import profilePhoto from "../assets/profile.jpg";
import { profile } from "../data/profile";
import BrandWord from "./BrandWord.astro";
import TomphieLogo from "./TomphieLogo.astro";
---

<section class="brand-scene home-hero relative overflow-hidden pb-20 pt-12 sm:pb-24 sm:pt-16 lg:pb-28 lg:pt-20" aria-labelledby="home-title">
  <BrandWord placement="hero" />

  <div class="relative z-10 mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
    <div class="hero-copy grid gap-8 lg:grid-cols-[minmax(0,1.55fr)_minmax(20rem,0.75fr)] lg:items-end">
      <div class="hero-identity">
        <TomphieLogo variant="wordmark" reveal class="hero-logo" />
        <h1 id="home-title" class="hero-title text-balance font-semibold leading-[0.9]">
          <span class="block text-[clamp(4.25rem,12vw,9.5rem)]">孔俊鑫</span>
          <span class="mt-3 block text-[clamp(2.25rem,5.5vw,4.75rem)] text-path">Tommy</span>
        </h1>
      </div>

      <div class="hero-support max-w-xl lg:pb-2">
        <p class="text-sm text-quiet">四川成都 · 电子科技大学</p>
        <p class="mt-5 text-pretty text-lg leading-8 sm:text-xl">
          {profile.heroLines.map((line) => <span class="block">{line}</span>)}
        </p>
        <p class="mt-5 text-sm text-quiet">也叫 {profile.aliases.join(" / ")}</p>
      </div>
    </div>

    <figure class="portrait-frame mt-12 overflow-hidden bg-line sm:mt-16">
      <div class="portrait-media">
        <Picture
          src={profilePhoto}
          formats={["avif", "webp"]}
          widths={[480, 768, 1200, 1600]}
          sizes="(max-width: 640px) 100vw, (max-width: 1280px) 92vw, 1200px"
          alt="孔俊鑫在湖边的个人照片"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <figcaption class="flex flex-wrap justify-between gap-2 border-t border-line bg-paper px-4 py-3 text-xs text-quiet sm:px-5">
        <span>Tomphie / sanjin</span>
        <span>好好吃饭 好好生活</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .portrait-media {
    aspect-ratio: 4 / 5;
  }

  .portrait-media :global(picture),
  .portrait-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .portrait-media :global(img) {
    object-fit: cover;
    object-position: 39% center;
  }

  @media (min-width: 40rem) {
    .portrait-media {
      aspect-ratio: 16 / 9;
    }

    .portrait-media :global(img) {
      object-position: center;
    }
  }

  :global(.hero-logo) {
    width: clamp(7rem, 14vw, 13.75rem);
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--color-ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-title,
    .hero-support,
    .portrait-frame {
      animation: hero-enter 620ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .hero-title {
      animation-delay: 780ms;
    }

    .hero-support {
      animation-delay: 920ms;
    }

    .portrait-frame {
      animation-delay: 1040ms;
    }
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
