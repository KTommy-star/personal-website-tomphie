---
import { Picture } from "astro:assets";
import profilePhoto from "../assets/profile.jpg";
import { profile } from "../data/profile";
---

<section class="home-hero pb-20 pt-14 sm:pb-28 sm:pt-20 lg:pb-36 lg:pt-24" aria-labelledby="home-title">
  <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
    <div class="hero-copy grid gap-10 lg:grid-cols-[minmax(0,1.65fr)_minmax(18rem,0.65fr)] lg:items-end">
      <h1 id="home-title" class="text-balance font-semibold leading-[0.92]">
        <span class="block text-[clamp(4.5rem,13vw,10rem)]">孔俊鑫</span>
        <span class="mt-3 block text-[clamp(2.25rem,6vw,5rem)] text-path">Tommy</span>
      </h1>

      <div class="max-w-lg lg:pb-3">
        <p class="text-sm text-quiet">四川成都 · 电子科技大学</p>
        <p class="mt-5 text-pretty text-lg leading-8 sm:text-xl">
          {profile.tagline}
        </p>
        <p class="mt-6 text-sm text-quiet">
          也叫 {profile.aliases.join(" / ")}
        </p>
      </div>
    </div>

    <figure class="portrait-frame mt-14 overflow-hidden bg-line sm:mt-20">
      <div class="portrait-media">
        <Picture
          src={profilePhoto}
          formats={["avif", "webp"]}
          widths={[480, 768, 1200, 1600]}
          sizes="(max-width: 640px) 100vw, (max-width: 1280px) 92vw, 1200px"
          alt="孔俊鑫在湖边的个人照片"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <figcaption class="flex flex-wrap justify-between gap-2 border-t border-line bg-paper px-4 py-3 text-xs text-quiet sm:px-5">
        <span>Tomphie / sanjin</span>
        <span>好好吃饭，好好生活</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .portrait-media {
    aspect-ratio: 4 / 5;
  }

  .portrait-media :global(picture),
  .portrait-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .portrait-media :global(img) {
    object-fit: cover;
    object-position: 39% center;
  }

  @media (min-width: 40rem) {
    .portrait-media {
      aspect-ratio: 16 / 9;
    }

    .portrait-media :global(img) {
      object-position: center;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy {
      animation: hero-enter 600ms ease-out both;
    }
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
