---
interface Props { placement: "hero" | "story" | "focus" | "routes" | "contact" | "journey"; }
const { placement } = Astro.props;
---
<div class:list={["brand-word", `brand-word--${placement}`]} data-brand-word="TOMPHIE" data-brand-placement={placement} aria-hidden="true">TOMPHIE</div>
<style>
  .brand-word { position: absolute; bottom: -.04em; right: 4%; width: 92%; font-family: Impact, "Arial Narrow", sans-serif; font-size: clamp(4rem, 17vw, 17rem); font-style: italic; font-weight: 900; letter-spacing: -.04em; line-height: 1; text-align: right; color: transparent; -webkit-text-stroke: 1px color-mix(in srgb, var(--color-path) 16%, transparent); opacity: .5; pointer-events: none; user-select: none; }
  .brand-word--hero { bottom: 4%; right: 4%; font-size: clamp(4rem, 15vw, 15rem); opacity: .8; }
  .brand-word--focus, .brand-word--contact { opacity: .25; }
  @media (max-width: 47.99rem) { .brand-word { font-size: 17vw; } }
</style>
