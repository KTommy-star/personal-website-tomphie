---
interface Props {
  title: string;
  description: string;
  accent?: "path" | "memory";
}

const { title, description, accent = "path" } = Astro.props;
---

<section class="border-b border-line py-20 sm:py-28 lg:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(18rem,1fr)] lg:items-end">
      <h1 class="max-w-4xl text-5xl font-semibold leading-[1.06] sm:text-6xl lg:text-7xl">
        {title}
      </h1>
      <div class="max-w-xl">
        <span aria-hidden="true" class:list={["mb-5 block size-3 rounded-full", accent === "memory" ? "bg-memory" : "bg-path"]}></span>
        <p class="text-base leading-8 text-quiet sm:text-lg">{description}</p>
      </div>
    </div>
  </div>
</section>
