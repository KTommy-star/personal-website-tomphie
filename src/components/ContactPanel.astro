---
import { profile } from "../data/profile";
import BrandWord from "./BrandWord.astro";

const copyContacts = [
  { label: "邮箱", value: profile.email },
  { label: "QQ", value: profile.qq },
  { label: "微信", value: profile.wechat },
];
---

<section class="brand-scene contact-section section-space relative overflow-hidden" aria-labelledby="contact-title">
  <BrandWord placement="contact" />

  <div class="shell relative z-10">
    <div class="contact-sheet glass" data-glass-light>
      <div>
        <p class="eyebrow mb-8">04 / 与我相遇</p>
        <p class="font-serif text-2xl leading-relaxed text-path sm:text-3xl">“{profile.quote}”</p>
        <h2 id="contact-title" class="editorial-title mt-6">
          <span class="block">好好规划未来的路</span>
          <span class="block">也认真过好当下</span>
        </h2>
        <p class="mt-6 max-w-2xl text-pretty text-sm leading-8 text-quiet">
          <span class="block">好好吃饭 好好生活 好好恋爱</span>
          <span class="block">研究交流 项目合作 有趣想法 都欢迎联系我</span>
        </p>
      </div>

      <div class="contact-list lg:justify-self-stretch">
        <p class="contact-invitation">让一场对话，成为新的起点 <span aria-hidden="true">↗</span></p>
        {copyContacts.map((contact) => (
          <button
            class="contact-action"
            type="button"
            data-copy-value={contact.value}
            data-press
            aria-label={`复制${contact.label} ${contact.value}`}
          >
            <span class="contact-label">{contact.label}</span>
            <span class="contact-value">{contact.value}</span>
            <span class="contact-state" data-copy-state>复制</span>
          </button>
        ))}

        <a class="contact-action" data-press href={profile.github} target="_blank" rel="noreferrer">
          <span class="contact-label">GitHub</span>
          <span class="contact-value">{profile.githubLabel}</span>
          <span class="contact-state">打开</span>
        </a>


        <p class="sr-only" aria-live="polite" data-copy-status></p>
      </div>
    </div>
  </div>
</section>

<script>
  const copyText = async (value: string) => {
    if (!navigator.clipboard || !window.isSecureContext) {
      throw new Error("clipboard unavailable");
    }

    await navigator.clipboard.writeText(value);
  };

  document.querySelectorAll<HTMLButtonElement>("[data-copy-value]").forEach((button) => {
    button.addEventListener("click", async () => {
      const value = button.dataset.copyValue;
      const state = button.querySelector<HTMLElement>("[data-copy-state]");
      const status = document.querySelector<HTMLElement>("[data-copy-status]");

      if (!value || !state || !status) return;

      try {
        await copyText(value);
        button.dataset.copied = "true";
        state.textContent = "已复制";
        status.textContent = `已复制 ${value}`;
      } catch {
        state.textContent = "复制失败";
        status.textContent = `未能复制 ${value}，请手动选择文本`;
      }

      window.setTimeout(() => {
        delete button.dataset.copied;
        state.textContent = "复制";
      }, 1600);
    });
  });
</script>

<style>
  .contact-section { padding-block: 7rem; }
  .contact-sheet { display: grid; grid-template-columns: 1.15fr 1fr; gap: 4rem; align-items: end; padding: 3rem; border-radius: 2rem; background: var(--color-surface-glass-strong); }
  .contact-sheet .editorial-title { font-size: clamp(2rem, 3.2vw, 3rem); }
  .contact-sheet > div > p.font-serif { font-size: 1.2rem; }
  .contact-invitation { display: flex; justify-content: space-between; padding-bottom: 1.5rem; font-size: .8rem; border-bottom: 1px solid var(--color-line); }
  @media (max-width: 63.99rem) { .contact-sheet { gap: 2.5rem; padding: 2rem; } }
  @media (max-width: 47.99rem) { .contact-section { padding-block: 4.5rem; } .contact-sheet { grid-template-columns: 1fr; padding: 1.5rem; border-radius: 1.4rem; } }
  .contact-action {
    display: grid;
    width: 100%;
    min-height: 3.5rem;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    border: 0;
    border-bottom: 0.0625rem solid var(--color-line);
    background: transparent;
    padding: 0.75rem 0;
    color: inherit;
    font: inherit;
    text-align: start;
    text-decoration: none;
    cursor: pointer;
    transition:
      color 150ms ease-out,
      transform 150ms ease-out;
  }

  .contact-action:hover {
    color: var(--color-path);
  }

  .contact-label,
  .contact-state {
    font-size: 0.75rem;
    color: var(--color-quiet);
  }

  .contact-value {
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .contact-state {
    justify-self: end;
  }

  .contact-action[data-copied="true"] .contact-state {
    color: var(--color-path);
  }
</style>
