---
import { profile } from "../data/profile";
import BrandWord from "./BrandWord.astro";
---

<section class="brand-scene relative overflow-hidden border-y border-line py-20 sm:py-24 lg:py-28" aria-labelledby="story-title">
  <BrandWord placement="story" />

  <div class="relative z-10 mx-auto grid max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-[minmax(16rem,0.65fr)_minmax(0,1.35fr)] lg:gap-16 lg:px-10">
    <aside class="lg:sticky lg:top-28 lg:self-start" aria-label="人生坐标">
      <p class="text-sm font-semibold">我的坐标</p>
      <ol class="story-path relative mt-7 grid gap-7 pl-8" role="list" data-story-progress>
        {profile.locations.map((location) => (
          <li class="relative" data-story-node>
            <span class="story-dot" aria-hidden="true"></span>
            <p class="font-semibold">{location.place}</p>
            <p class="mt-1 text-sm text-quiet">{location.note}</p>
          </li>
        ))}
      </ol>
    </aside>

    <article class="max-w-3xl">
      <h2 id="story-title" class="text-balance text-4xl font-semibold leading-[1.14] sm:text-5xl lg:text-6xl">
        <span class="block">从山城出发</span>
        <span class="block">在更大的世界里寻找坐标</span>
      </h2>
      <div class="story-copy mt-10 grid gap-7 text-pretty text-lg leading-9 text-quiet sm:text-xl sm:leading-10">
        {profile.story.map((paragraph) => (
          <p>
            {paragraph.map((line) => <span class="block">{line}</span>)}
          </p>
        ))}
      </div>
    </article>
  </div>
</section>

<style>
  .story-path::before,
  .story-path::after {
    content: "";
    position: absolute;
    inset-block: 0.5rem;
    inset-inline-start: 0.3125rem;
    width: 0.125rem;
    transform-origin: top;
  }

  .story-path::before {
    background: var(--color-line);
  }

  .story-path::after {
    background: var(--color-path);
    transform: scaleY(var(--story-progress, 0));
    transform-origin: top;
    will-change: transform;
  }

  .story-dot {
    position: absolute;
    inset-block-start: 0.375rem;
    inset-inline-start: -2rem;
    z-index: 10;
    display: block;
    width: 0.75rem;
    height: 0.75rem;
    border: 0.1875rem solid var(--color-paper);
    border-radius: 9999px;
    background: var(--color-path);
    opacity: 0.72;
    transition:
      opacity 180ms ease-out,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .story-path [data-story-node][data-story-active="true"] .story-dot {
    opacity: 1;
    transform: scale(1.3);
  }

  .story-path [data-story-node][data-story-active="true"] p:first-of-type {
    color: var(--color-path);
  }

  @media (hover: hover) {
    .story-path:hover .story-dot {
      transform: scale(1.16);
    }
  }

  @supports (animation-timeline: view()) {
    .story-copy {
      animation: story-enter linear both;
      animation-range: entry 0% entry 32%;
      animation-timeline: view();
    }
  }

  @keyframes story-enter {
    from {
      opacity: 0.45;
      transform: translateY(1.25rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .story-path::after {
      transition: none;
    }

    .story-copy {
      animation: none;
      transform: none;
    }
  }
</style>

<script>
  import { calculateRouteProgress } from "../lib/route-progress";

  document.querySelectorAll<HTMLOListElement>("[data-story-progress]").forEach((path) => {
    const nodes = Array.from(path.querySelectorAll<HTMLElement>("[data-story-node]"));
    let frame = 0;

    const updateProgress = () => {
      frame = 0;
      const rect = path.getBoundingClientRect();
      const value = calculateRouteProgress(rect.top, rect.bottom, window.innerHeight);
      path.style.setProperty("--story-progress", String(value));

      const activationLine = window.innerHeight * 0.52;
      nodes.forEach((node) => {
        const nodeRect = node.getBoundingClientRect();
        const active = nodeRect.top + nodeRect.height / 2 <= activationLine;
        node.dataset.storyActive = String(active);
      });
    };

    const requestUpdate = () => {
      if (frame === 0) frame = window.requestAnimationFrame(updateProgress);
    };

    requestUpdate();
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate);
  });
</script>
