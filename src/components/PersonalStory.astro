---
import { profile } from "../data/profile";
---

<section class="border-y border-line py-20 sm:py-28 lg:py-36" aria-labelledby="story-title">
  <div class="mx-auto grid max-w-7xl gap-16 px-5 sm:px-8 lg:grid-cols-[minmax(16rem,0.7fr)_minmax(0,1.3fr)] lg:px-10">
    <aside class="lg:sticky lg:top-28 lg:self-start" aria-label="人生坐标">
      <p class="text-sm font-semibold">我的坐标</p>
      <ol class="story-path relative mt-8 grid gap-8 pl-8" role="list">
        {profile.locations.map((location) => (
          <li class="relative">
            <span class="story-dot" aria-hidden="true"></span>
            <p class="font-semibold">{location.place}</p>
            <p class="mt-1 text-sm text-quiet">{location.note}</p>
          </li>
        ))}
      </ol>
    </aside>

    <article class="max-w-3xl">
      <h2 id="story-title" class="text-balance text-4xl font-semibold leading-tight sm:text-5xl lg:text-6xl">
        从山城出发，<br class="hidden sm:block" />
        在更大的世界里寻找坐标。
      </h2>
      <div class="mt-12 grid gap-8 text-pretty text-lg leading-9 text-quiet sm:text-xl sm:leading-10">
        {profile.story.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </article>
  </div>
</section>

<style>
  .story-path::before,
  .story-path::after {
    content: "";
    position: absolute;
    inset-block: 0.5rem;
    inset-inline-start: 0.3125rem;
    width: 0.125rem;
    transform-origin: top;
  }

  .story-path::before {
    background: var(--color-line);
  }

  .story-path::after {
    background: var(--color-path);
    transform: scaleY(0.12);
  }

  .story-dot {
    position: absolute;
    inset-block-start: 0.375rem;
    inset-inline-start: -2rem;
    z-index: 10;
    display: block;
    width: 0.75rem;
    height: 0.75rem;
    border: 0.1875rem solid var(--color-paper);
    border-radius: 9999px;
    background: var(--color-path);
  }

  @supports (animation-timeline: view()) {
    .story-path::after {
      animation: story-progress linear both;
      animation-range: entry 10% exit 75%;
      animation-timeline: view();
    }
  }

  @keyframes story-progress {
    to {
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .story-path::after {
      animation: none;
      transform: scaleY(1);
    }
  }
</style>
