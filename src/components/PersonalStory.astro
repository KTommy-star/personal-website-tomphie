---
import { profile } from "../data/profile";
import BrandWord from "./BrandWord.astro";
import { withBase } from "../lib/paths";
---

<section class="brand-scene story-section reading-surface section-space relative overflow-clip" aria-labelledby="story-title">
  <BrandWord placement="story" />

  <div class="shell story-grid relative z-10">
    <aside class="story-atlas glass" aria-label="人生坐标" data-glass-light>
      <p class="eyebrow">01 / 来路</p>
      <p class="atlas-title">我的坐标</p>
      <ol class="story-path relative mt-7 grid gap-7 pl-8" role="list" data-story-progress>
        {profile.locations.map((location) => (
          <li class="relative" data-story-node>
            <span class="story-dot" aria-hidden="true"></span>
            <p class="font-semibold">{location.place}</p>
            <p class="mt-1 text-sm text-quiet">{location.note}</p>
          </li>
        ))}
      </ol>
      <svg class="atlas-contours" viewBox="0 0 260 135" fill="none" stroke="currentColor" stroke-width=".8" aria-hidden="true"><path d="M-20 102Q38 44 73 75T151 64T278 50M-20 88Q38 30 73 61T151 50T278 36M-20 74Q38 16 73 47T151 36T278 22M-20 60Q38 2 73 33T151 22T278 8M-20 116Q38 58 73 89T151 78T278 64M-20 130Q38 72 73 103T151 92T278 78"/></svg>
      <a class="atlas-link" data-press href={withBase("/journey", import.meta.env.BASE_URL)}>展开人生轨迹 <span aria-hidden="true">↗</span></a>
    </aside>

    <article class="max-w-3xl">
      <h2 id="story-title" class="editorial-title">
        <span class="block">从山城出发</span>
        <span class="block">在更大的世界里寻找坐标</span>
      </h2>
      <div class="story-copy">
        {profile.story.map((paragraph, index) => (
          <p>
            <span class="story-paragraph-label">0{index + 1} <span>{["关于来路", "关于此刻", "关于远方"][index]}</span></span>
            {paragraph.map((line) => <span class="block">{line}</span>)}
          </p>
        ))}
      </div>
    </article>
  </div>
</section>

<style>
  .story-section { border-radius: 2.5rem 2.5rem 0 0; }
  .story-grid { display: grid; grid-template-columns: minmax(15rem,.7fr) minmax(0,1.3fr); gap: 6rem; align-items: start; }
  .story-atlas { position: sticky; top: 7rem; padding: 2rem; border-radius: 1.5rem; overflow: hidden; }
  .atlas-title { font-family: var(--font-serif); font-size: 1.65rem; margin-top: 1.6rem; }
  .atlas-contours { width: calc(100% + 4rem); height: 7rem; margin: 1rem -2rem .5rem; color: var(--color-path); opacity: .24; }
  .atlas-link { display: flex; justify-content: space-between; align-items: center; min-height: 2.75rem; border-top: 1px solid var(--color-line); padding-top: 1rem; font-size: .8rem; color: var(--color-path); text-decoration: none; }
  .story-copy { display: grid; gap: 2.2rem; margin-top: 2.3rem; font-size: .98rem; line-height: 2.15; color: var(--color-quiet); }
  .story-paragraph-label { display: block; margin-bottom: .7rem; color: var(--color-path); font-size: .6rem; letter-spacing: .1em; }
  .story-paragraph-label span { margin-left: .8rem; }
  @media (max-width: 63.99rem) { .story-grid { gap: 3rem; grid-template-columns: minmax(13rem,.8fr) minmax(0,1.2fr); } .story-atlas { padding: 1.5rem; } }
  @media (max-width: 47.99rem) { .story-grid { grid-template-columns: 1fr; gap: 2.5rem; } .story-atlas { position: static; padding: 1.5rem; } .atlas-contours { position: absolute; bottom: 3rem; right: -5rem; width: 70%; margin: 0; opacity: .1; } .story-copy { font-size: .92rem; } }
  .story-path::before,
  .story-path::after {
    content: "";
    position: absolute;
    inset-block: 0.5rem;
    inset-inline-start: 0.3125rem;
    width: 0.125rem;
    transform-origin: top;
  }

  .story-path::before {
    background: var(--color-line);
  }

  .story-path::after {
    background: var(--color-path);
    transform: scaleY(var(--story-progress, 0));
    transform-origin: top;
    will-change: transform;
  }

  .story-dot {
    position: absolute;
    inset-block-start: 0.375rem;
    inset-inline-start: -2rem;
    z-index: 10;
    display: block;
    width: 0.75rem;
    height: 0.75rem;
    border: 0.1875rem solid var(--color-paper);
    border-radius: 9999px;
    background: var(--color-path);
    opacity: 0.72;
    transition:
      opacity 180ms ease-out,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .story-path [data-story-node][data-story-active="true"] .story-dot {
    opacity: 1;
    transform: scale(1.3);
  }

  .story-path [data-story-node][data-story-active="true"] p:first-of-type {
    color: var(--color-path);
  }

  @media (hover: hover) {
    .story-path:hover .story-dot {
      transform: scale(1.16);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .story-path::after {
      transition: none;
    }

    .story-copy {
      animation: none;
      transform: none;
    }
  }
</style>

<script>
  import { calculateRouteProgress } from "../lib/route-progress";

  document.querySelectorAll<HTMLOListElement>("[data-story-progress]").forEach((path) => {
    const nodes = Array.from(path.querySelectorAll<HTMLElement>("[data-story-node]"));
    const section = path.closest<HTMLElement>(".story-section");
    if (!section) return;
    let frame = 0;

    const updateProgress = () => {
      frame = 0;
      const rect = section.getBoundingClientRect();
      const value = calculateRouteProgress(rect.top, rect.bottom, window.innerHeight);
      path.style.setProperty("--story-progress", String(value));

      nodes.forEach((node, index) => {
        node.dataset.storyActive = String(value >= index / Math.max(1, nodes.length - 1));
      });
    };

    const requestUpdate = () => {
      if (frame === 0) frame = window.requestAnimationFrame(updateProgress);
    };

    requestUpdate();
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate);
  });
</script>
