---
import { navigation } from "../data/navigation";
import { withBase } from "../lib/paths";

const base = import.meta.env.BASE_URL;
const destinations = navigation.filter((item) => item.href !== "/");
---

<section class="route-index border-t border-line py-20 sm:py-24" aria-labelledby="route-index-title">
  <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
    <div class="mb-12 grid gap-5 md:grid-cols-2 md:items-end">
      <h2 id="route-index-title" class="max-w-xl text-3xl font-semibold leading-tight sm:text-5xl">
        <span class="block">从一个坐标</span>
        <span class="block">走向不同的内容</span>
      </h2>
      <p class="max-w-xl text-quiet md:justify-self-end">
        <span class="block">路径是全站共同的线索</span>
        <span class="block">但不会替代清楚的文字与导航</span>
      </p>
    </div>

    <div class="relative">
      <div class="route-line" aria-hidden="true">
        <span class="route-progress"></span>
      </div>

      <ol class="grid gap-4 sm:gap-6">
        {destinations.map((item) => (
          <li class="route-item">
            <span class="route-dot" aria-hidden="true"></span>
            <a
              class="route-card group grid min-h-32 gap-3 border-y border-line bg-paper py-6 no-underline sm:grid-cols-[minmax(8rem,0.65fr)_minmax(0,1fr)] sm:items-center sm:py-7"
              href={withBase(item.href, base)}
            >
              <span class="route-title text-xl font-semibold">{item.label}</span>
              <span class="max-w-xl text-sm leading-7 text-quiet">{item.description}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .route-line {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0.5rem;
    width: 0.125rem;
    background: var(--color-line);
  }

  .route-progress {
    position: absolute;
    inset: 0;
    display: block;
    background: var(--color-path);
    transform: scaleY(0.08);
    transform-origin: top;
  }

  .route-item {
    position: relative;
    padding-inline-start: 2.5rem;
  }

  .route-dot {
    position: absolute;
    z-index: 10;
    inset-block-start: 50%;
    inset-inline-start: 0;
    width: 1.125rem;
    height: 1.125rem;
    border: 0.25rem solid var(--color-paper);
    border-radius: 9999px;
    background: var(--color-path);
    transform: translateY(-50%);
    transition: transform 180ms ease-out;
  }

  .route-card {
    transition:
      color 180ms ease-out,
      transform 180ms ease-out;
  }

  .route-card:hover,
  .route-card:focus-visible {
    transform: translateY(-0.25rem);
  }

  .route-card:hover .route-title,
  .route-card:focus-visible .route-title {
    color: var(--color-path);
  }

  .route-item:focus-within .route-dot,
  .route-item:hover .route-dot {
    transform: translateY(-50%) scale(1.2);
  }

  @supports (animation-timeline: view()) {
    .route-progress {
      animation: route-grow linear both;
      animation-range: entry 5% exit 90%;
      animation-timeline: view();
    }
  }

  @keyframes route-grow {
    from {
      transform: scaleY(0.08);
    }

    to {
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .route-progress {
      animation: none;
      transform: scaleY(1);
    }
  }

  @media (min-width: 48rem) {
    .route-line {
      inset-inline-start: 50%;
      transform: translateX(-50%);
    }

    .route-item {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-inline-start: 0;
    }

    .route-item:nth-child(odd) a {
      grid-column: 1;
      margin-inline-end: 3rem;
    }

    .route-item:nth-child(even) a {
      grid-column: 2;
      margin-inline-start: 3rem;
    }

    .route-dot {
      inset-inline-start: 50%;
      transform: translate(-50%, -50%);
    }

    .route-item:focus-within .route-dot,
    .route-item:hover .route-dot {
      transform: translate(-50%, -50%) scale(1.2);
    }
  }
</style>
