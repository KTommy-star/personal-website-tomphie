---
import { navigation } from "../data/navigation";
import { withBase } from "../lib/paths";
import BrandWord from "./BrandWord.astro";

const base = import.meta.env.BASE_URL;
const destinations = navigation.filter((item) => item.href !== "/");
---

<section class="brand-scene route-index relative overflow-hidden border-t border-line py-20 sm:py-24" aria-labelledby="route-index-title">
  <BrandWord placement="routes" />

  <div class="relative z-10 mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
    <div class="mb-12 grid gap-5 md:grid-cols-2 md:items-end">
      <h2 id="route-index-title" class="max-w-xl text-3xl font-semibold leading-tight sm:text-5xl">
        <span class="block">从一个坐标</span>
        <span class="block">走向不同的内容</span>
      </h2>
      <p class="max-w-xl text-quiet md:justify-self-end">
        <span class="block">路径是全站共同的线索</span>
        <span class="block">但不会替代清楚的文字与导航</span>
      </p>
    </div>

    <div class="relative">
      <div class="route-line" aria-hidden="true" data-route-line>
        <span class="route-progress" data-route-progress></span>
      </div>

      <ol class="grid gap-4 sm:gap-6">
        {destinations.map((item) => (
          <li class="route-item">
            <span class="route-dot" aria-hidden="true"></span>
            <a
              class="route-card group grid min-h-32 gap-3 border-y border-line py-6 no-underline sm:grid-cols-[minmax(8rem,0.65fr)_minmax(0,1fr)] sm:items-center sm:py-7"
              data-route-card
              href={withBase(item.href, base)}
            >
              <span class="route-title text-xl font-semibold">{item.label}</span>
              <span class="max-w-xl text-sm leading-7 text-quiet">{item.description}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .route-line {
    position: absolute;
    z-index: 0;
    inset-block: 0;
    inset-inline-start: 0.5rem;
    width: 0.125rem;
    background: var(--color-line);
    pointer-events: none;
  }

  .route-progress {
    position: absolute;
    inset: 0;
    display: block;
    background: var(--color-path);
    transform: scaleY(0);
    transform-origin: top;
    will-change: transform;
  }

  .route-item {
    position: relative;
    padding-inline-start: 2.5rem;
  }

  .route-dot {
    position: absolute;
    z-index: 10;
    inset-block-start: 50%;
    inset-inline-start: 0;
    width: 1.125rem;
    height: 1.125rem;
    border: 0.25rem solid var(--color-paper);
    border-radius: 9999px;
    background: var(--color-path);
    transform: translateY(-50%);
    transition: transform 180ms ease-out;
  }

  .route-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-color: color-mix(in srgb, var(--color-line) 82%, transparent);
    background: rgba(244, 247, 250, 0.72);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    transition:
      background 220ms ease-out,
      border-color 220ms ease-out,
      color 220ms ease-out,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .route-card::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      radial-gradient(circle at 8% 50%, color-mix(in srgb, var(--color-path) 12%, transparent), transparent 34%),
      linear-gradient(90deg, color-mix(in srgb, white 28%, transparent), transparent 62%);
    content: "";
    opacity: 0;
    transition: opacity 220ms ease-out;
  }

  .route-card:focus-visible {
    border-color: color-mix(in srgb, var(--color-path) 36%, var(--color-line));
    background: rgba(244, 247, 250, 0.58);
    transform: translateY(-0.25rem);
  }

  .route-card:focus-visible::before {
    opacity: 1;
  }

  .route-card:focus-visible .route-title {
    color: var(--color-path);
  }

  @media (hover: hover) {
    .route-card:hover {
      border-color: color-mix(in srgb, var(--color-path) 36%, var(--color-line));
      background: rgba(244, 247, 250, 0.58);
      transform: translateY(-0.25rem);
    }

    .route-card:hover::before {
      opacity: 1;
    }

    .route-card:hover .route-title {
      color: var(--color-path);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .route-card:active {
      transform: translateY(-0.08rem) scale(0.985);
    }
  }

  .route-card > * {
    position: relative;
    z-index: 1;
  }

  .route-item:focus-within .route-dot {
    transform: translateY(-50%) scale(1.2);
  }

  @media (prefers-reduced-motion: reduce) {
    .route-progress {
      transition: none;
    }
  }

  @media (max-width: 39.99rem) {
    .route-item {
      padding-inline-start: 2.25rem;
    }

    .route-line {
      inset-inline-start: 0.375rem;
    }

    .route-dot {
      width: 1rem;
      height: 1rem;
      border-width: 0.1875rem;
    }

    .route-card {
      min-height: 7.25rem;
      gap: 0.5rem;
      padding-block: 1.25rem;
      background: rgba(244, 247, 250, 0.82);
      backdrop-filter: blur(3px);
      -webkit-backdrop-filter: blur(3px);
    }
  }

  @media (hover: hover) {
    .route-item:hover .route-dot {
      transform: translateY(-50%) scale(1.2);
    }
  }

  @media (min-width: 48rem) {
    .route-line {
      inset-inline-start: 50%;
      transform: translateX(-50%);
    }

    .route-item {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-inline-start: 0;
    }

    .route-item:nth-child(odd) a {
      grid-column: 1;
      margin-inline-end: 3rem;
    }

    .route-item:nth-child(even) a {
      grid-column: 2;
      margin-inline-start: 3rem;
    }

    .route-dot {
      inset-inline-start: 50%;
      transform: translate(-50%, -50%);
    }

    .route-item:focus-within .route-dot,
    .route-item:hover .route-dot {
      transform: translate(-50%, -50%) scale(1.2);
    }
  }
</style>


<script>
  import { calculateRouteProgress } from "../lib/route-progress";

  document.querySelectorAll<HTMLElement>("[data-route-line]").forEach((line) => {
    const progress = line.querySelector<HTMLElement>("[data-route-progress]");
    const section = line.closest<HTMLElement>(".route-index");

    if (!progress || !section) return;

    let frame = 0;

    const updateProgress = () => {
      frame = 0;
      const rect = line.getBoundingClientRect();
      const value = calculateRouteProgress(rect.top, rect.bottom, window.innerHeight);
      progress.style.transform = `scaleY(${value})`;
      section.dataset.routeProgressReady = "true";
    };

    const requestUpdate = () => {
      if (frame === 0) frame = window.requestAnimationFrame(updateProgress);
    };

    requestUpdate();
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate);
  });
</script>
