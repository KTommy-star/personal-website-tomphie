---
import { navigation } from "../data/navigation";
import { withBase } from "../lib/paths";
import BrandWord from "./BrandWord.astro";
const base = import.meta.env.BASE_URL;
const destinations = navigation.filter(item => item.href !== "/");
const subtitles = ["A PATH STILL UNFOLDING", "QUESTIONS WORTH ASKING", "IDEAS INTO PRACTICE", "LEARNING IN THE OPEN"];
---

<section class="brand-scene route-index reading-surface section-space relative overflow-hidden" aria-labelledby="route-index-title">
  <BrandWord placement="routes" />
  <div class="shell relative z-10">
    <div class="route-heading"><div><p class="eyebrow">03 / 我的个人档案</p><h2 id="route-index-title" class="editorial-title"><span>从一个坐标</span><span>走向不同的内容</span></h2></div><p>沿着来路，记录探索<br />也为新的故事留出位置</p></div>
    <div class="route-gallery">
      <div class="route-line" aria-hidden="true" data-route-line><span class="route-progress" data-route-progress></span></div>
      <ol role="list">
        {destinations.map((item, index) => (
          <li class:list={["route-item", `route-item--${index}`]}>
            <span class="route-dot" aria-hidden="true"></span>
            <a class="route-card glass" data-route-card data-glass-light href={withBase(item.href, base)}>
              <div class="route-card__top"><span class="section-serial">0{index + 1}</span><span class="route-open" aria-hidden="true">↗</span></div>
              <div class="route-art" aria-hidden="true">
                {index === 0 && <svg viewBox="0 0 460 200" fill="none" stroke="currentColor" stroke-width=".8"><path d="M-10 155Q65 33 110 112T207 82T308 85T474 37M-10 170Q65 48 110 127T207 97T308 100T474 52M-10 185Q65 63 110 142T207 112T308 115T474 67M-10 140Q65 18 110 97T207 67T308 70T474 22M-10 125Q65 3 110 82T207 52T308 55T474 7" opacity=".3"/><path d="M80 131C140 160 186 57 242 85S317 125 366 68" stroke-dasharray="4 5" stroke-width="1.2"/><g fill="var(--color-surface)"><circle cx="80" cy="131" r="5"/><circle cx="242" cy="85" r="5"/><circle cx="366" cy="68" r="5"/></g><path d="m76 131 4-4 4 4m154-46 4-4 4 4m120-17 4-4 4 4"/></svg>}
                {index === 1 && <svg viewBox="0 0 460 200" fill="none" stroke="currentColor"><g stroke-width=".8"><circle cx="198" cy="100" r="64"/><circle cx="263" cy="100" r="64"/><circle cx="230" cy="100" r="86" opacity=".18"/><path d="M100 100h42m-15-10v20m204-10h29m-15-10v20" opacity=".4"/><path d="M231 53v94" stroke-dasharray="2 5" opacity=".4"/></g><circle cx="230" cy="100" r="7" fill="currentColor"/><circle cx="230" cy="100" r="20" stroke-width=".5" opacity=".35"/></svg>}
                {index === 2 && <svg viewBox="0 0 460 200" fill="none" stroke="currentColor" stroke-width=".8"><rect x="140" y="29" width="225" height="135" rx="10" opacity=".18"/><rect x="95" y="44" width="225" height="135" rx="10"/><path d="M95 70h225M174 93l-20 17 20 17m61-34 20 17-20 17m-14-38-22 42"/><circle cx="112" cy="57" r="2"/><circle cx="124" cy="57" r="2"/><circle cx="136" cy="57" r="2"/><path d="M120 154h26m7 0h68m7 0h28" opacity=".45"/></svg>}
                {index === 3 && <svg viewBox="0 0 460 200" fill="none" stroke="currentColor" stroke-width=".8"><path d="M177 20h114l26 27v138H177Z" opacity=".18"/><path d="M149 20h114l26 27v138H149Z"/><path d="M263 20v27h26M175 74h75M175 89h89M175 104h71M175 134h61M175 148h78"/><path d="m111 64 9 9 17-19M315 122h28m-14-14v28" opacity=".4"/></svg>}
              </div>
              <div class="route-card__bottom"><div><p class="route-subtitle">{subtitles[index]}</p><h3>{item.label}</h3><p class="route-description">{item.description}</p></div><span class="route-discover">探索 <span aria-hidden="true">→</span></span></div>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .route-heading { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: 3.5rem; }
  .route-heading h2 { margin-top: 1.5rem; }
  .route-heading h2 span { display: block; }
  .route-heading > p { font-size: .85rem; line-height: 1.9; color: var(--color-quiet); margin-bottom: .5rem; }
  .route-gallery { position: relative; padding-left: 2rem; }
  .route-gallery ol { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; align-items: start; }
  .route-line { position: absolute; z-index: 0; inset-block: 0; left: 0; width: 1px; background: var(--color-line); pointer-events: none; }
  .route-progress { position: absolute; inset: 0; display: block; background: var(--color-path); transform: scaleY(0); transform-origin: top; }
  .route-item { position: relative; }
  .route-item:nth-child(2) { margin-top: 3.5rem; }
  .route-item:nth-child(3) { margin-top: -3.5rem; }
  .route-dot { position: absolute; top: 2rem; left: -2.25rem; width: .55rem; height: .55rem; border-radius: 50%; background: var(--color-path); }
  .route-item:nth-child(even) .route-dot { display: none; }
  .route-card { display: block; padding: 1.5rem 1.75rem 1.75rem; border-radius: 1.4rem; color: inherit; text-decoration: none; overflow: hidden; transition: transform 300ms cubic-bezier(.22,1,.36,1), box-shadow 300ms ease, background 700ms ease; }
  .route-card__top { display: flex; justify-content: space-between; align-items: center; }
  .route-open { display: grid; width: 2.5rem; height: 2.5rem; place-items: center; border: 1px solid var(--color-line); border-radius: 50%; transition: transform 300ms ease, background 300ms ease; }
  .route-art { color: var(--color-path); margin-block: .75rem 1.2rem; }
  .route-art svg { display: block; width: 100%; height: auto; transition: transform 400ms cubic-bezier(.22,1,.36,1); }
  .route-card__bottom { display: flex; justify-content: space-between; align-items: end; gap: 1rem; border-top: 1px solid var(--color-line); padding-top: 1.25rem; }
  .route-subtitle { font-size: .53rem; letter-spacing: .14em; color: var(--color-quiet); }
  .route-card h3 { font-family: var(--font-serif); font-size: 1.7rem; font-weight: 500; margin-top: .5rem; }
  .route-description { font-size: .75rem; margin-top: .5rem; color: var(--color-quiet); line-height: 1.85; }
  .route-discover { display: flex; gap: .75rem; white-space: nowrap; font-size: .65rem; color: var(--color-path); padding-bottom: .1rem; }
  @media (hover: hover) { .route-card:hover { transform: translateY(-5px); box-shadow: 0 24px 50px rgba(16,52,57,.12); } .route-card:hover .route-art svg { transform: scale(1.03); } .route-card:hover .route-open { transform: rotate(45deg); background: color-mix(in srgb, var(--color-path) 8%, transparent); } }
  .route-card:focus-visible { transform: translateY(-4px); }
  .route-card:active { transform: scale(.985); transition-duration: 100ms; }
  @media (max-width: 47.99rem) { .route-heading { display: block; margin-bottom: 2rem; } .route-heading > p { margin-top: 1rem; } .route-gallery { padding-left: 1.1rem; } .route-gallery ol { grid-template-columns: 1fr; gap: 1rem; } .route-item:nth-child(2), .route-item:nth-child(3) { margin-top: 0; } .route-item:nth-child(even) .route-dot { display: block; } .route-dot { left: -1.35rem; } .route-card { padding: 1.1rem 1.2rem 1.4rem; } .route-art { margin-block: .2rem .8rem; } .route-art svg { max-height: 9rem; } .route-card h3 { font-size: 1.5rem; } }
  @media (prefers-reduced-motion: reduce) { .route-card:hover, .route-card:active, .route-card:focus-visible, .route-card:hover .route-art svg, .route-card:hover .route-open { transform: none; } }
</style>

<script>
  import { calculateRouteProgress } from "../lib/route-progress";
  document.querySelectorAll<HTMLElement>("[data-route-line]").forEach(line => {
    const progress = line.querySelector<HTMLElement>("[data-route-progress]");
    if (!progress) return;
    let frame = 0;
    const update = () => { frame = 0; const rect = line.getBoundingClientRect(); progress.style.transform = `scaleY(${calculateRouteProgress(rect.top, rect.bottom, innerHeight)})`; };
    const requestUpdate = () => { if (!frame) frame = requestAnimationFrame(update); };
    requestUpdate();
    addEventListener("scroll", requestUpdate, { passive: true });
    addEventListener("resize", requestUpdate);
  });
</script>
