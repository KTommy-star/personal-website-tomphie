---
import TomphieLogo from "./TomphieLogo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { navigation } from "../data/navigation";
import { withBase } from "../lib/paths";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const base = import.meta.env.BASE_URL;

const normalize = (path: string) =>
  path.length > 1 ? path.replace(/\/+$/, "") : path;

const isCurrent = (href: string) => {
  const target = normalize(withBase(href, base));
  const current = normalize(pathname);
  return current === target || (target !== "/" && current.startsWith(`${target}/`));
};
---

<header class="site-header">
  <div class="header-pane glass shell" data-glass-light>
    <a
      class="brand-link group inline-flex min-h-11 items-center gap-2.5 text-base font-semibold no-underline"
      href={withBase("/", base)}
      aria-label="Tomphie 首页"
    >
      <TomphieLogo variant="icon" class="brand-logo" />
      <span>Tomphie</span>
    </a>

    <nav class="hidden md:block" aria-label="主导航">
      <ul class="flex items-center gap-1" role="list">
        {navigation.map((item) => (
          <li>
            <a
              class:list={[
                "nav-link relative inline-flex min-h-11 items-center px-3 text-sm no-underline transition-colors duration-150",
                isCurrent(item.href) ? "text-ink" : "text-quiet hover:text-ink",
              ]}
              href={withBase(item.href, base)}
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions inline-flex items-center gap-2">
      <ThemeToggle />

      <details class="mobile-menu relative md:hidden">
        <summary class="flex min-h-11 cursor-pointer list-none items-center px-2 text-sm font-medium">
          <span class="sr-only">菜单</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
        </summary>
        <nav
          class="mobile-menu-pane absolute right-0 top-full z-40 mt-3 w-52 p-2 shadow-lg"
          aria-label="移动端主导航"
        >
          <ul class="grid gap-1" role="list">
            {navigation.map((item) => (
              <li>
                <a
                  class:list={[
                    "flex min-h-11 items-center px-3 text-sm no-underline transition-colors duration-150",
                    isCurrent(item.href) ? "bg-ink text-on-ink" : "text-ink hover:bg-surface",
                  ]}
                  href={withBase(item.href, base)}
                  aria-current={isCurrent(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header { position: fixed; top: 1rem; left: 0; right: 0; z-index: 40; pointer-events: none; }
  .header-pane { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 3.6rem; padding: .25rem 1.25rem; border-radius: 999px; pointer-events: auto; background: var(--color-surface-glass-strong); -webkit-backdrop-filter: blur(8px) saturate(120%); backdrop-filter: blur(8px) saturate(120%); }
  .brand-link { font-size: .9rem; letter-spacing: -.025em; }
  .nav-link[aria-current="page"] { background: color-mix(in srgb, var(--color-ink) 7%, transparent); border-radius: 999px; }
  .mobile-menu-pane { border: 1px solid var(--color-line); border-radius: 1.2rem; background: var(--color-surface); }
  summary::-webkit-details-marker { display: none; }
  :global(.tomphie-logo.brand-logo) {
    width: 1.5rem;
    color: var(--color-path);
    transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .brand-link:hover :global(.brand-logo),
  .brand-link:focus-visible :global(.tomphie-logo.brand-logo) {
    transform: translate(0.125rem, -0.0625rem);
  }

  @media (max-width: 24rem) {
    :global(.tomphie-logo.brand-logo) {
      width: 1.375rem;
    }
  }

  .nav-link::after {
    content: "";
    position: absolute;
    inset-block-end: 0.6rem;
    inset-inline: 0.75rem;
    height: 1px;
    background: var(--color-path);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease-out;
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link[aria-current="page"]::after {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu[open] nav {
      animation: menu-enter 160ms ease-out both;
      transform-origin: top right;
    }
  }

  @keyframes menu-enter {
    from {
      opacity: 0;
      transform: translateY(-0.375rem) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 47.99rem) { .site-header { top: .7rem; } .header-pane { padding-inline: .85rem; } }
</style>

<script>
  document.querySelectorAll<HTMLDetailsElement>(".mobile-menu").forEach((menu) => {
    const summary = menu.querySelector("summary");
    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape") { menu.open = false; summary?.focus(); }
    });
    document.addEventListener("pointerdown", (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
  });
</script>
