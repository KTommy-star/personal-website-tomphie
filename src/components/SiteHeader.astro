---
import TomphieLogo from "./TomphieLogo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { navigation } from "../data/navigation";
import { withBase } from "../lib/paths";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const base = import.meta.env.BASE_URL;

const normalize = (path: string) =>
  path.length > 1 ? path.replace(/\/+$/, "") : path;

const isCurrent = (href: string) => {
  const target = normalize(withBase(href, base));
  const current = normalize(pathname);
  return current === target || (target !== "/" && current.startsWith(`${target}/`));
};
---

<header class="site-header sticky top-0 z-40 border-b border-line bg-paper/95">
  <div class="mx-auto flex min-h-16 max-w-7xl items-center justify-between gap-6 px-5 sm:px-8 lg:px-10">
    <a
      class="brand-link group inline-flex min-h-11 items-center gap-2.5 text-base font-semibold no-underline"
      href={withBase("/", base)}
      aria-label="Tomphie 首页"
    >
      <TomphieLogo variant="icon" class="brand-logo" />
      <span>Tomphie</span>
    </a>

    <nav class="hidden md:block" aria-label="主导航">
      <ul class="flex items-center gap-1" role="list">
        {navigation.map((item) => (
          <li>
            <a
              class:list={[
                "nav-link relative inline-flex min-h-11 items-center px-3 text-sm no-underline transition-colors duration-150",
                isCurrent(item.href) ? "text-ink" : "text-quiet hover:text-ink",
              ]}
              href={withBase(item.href, base)}
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions inline-flex items-center gap-2">
      <ThemeToggle />

      <details class="mobile-menu relative md:hidden">
        <summary class="flex min-h-11 cursor-pointer list-none items-center px-2 text-sm font-medium">
          菜单
        </summary>
        <nav
          class="absolute right-0 top-full z-40 mt-2 w-52 border border-line bg-paper p-2 shadow-lg"
          aria-label="移动端主导航"
        >
          <ul class="grid gap-1" role="list">
            {navigation.map((item) => (
              <li>
                <a
                  class:list={[
                    "flex min-h-11 items-center px-3 text-sm no-underline transition-colors duration-150",
                    isCurrent(item.href) ? "bg-ink text-on-ink" : "text-ink hover:bg-surface",
                  ]}
                  href={withBase(item.href, base)}
                  aria-current={isCurrent(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  :global(.brand-logo) {
    width: 2rem;
    color: var(--color-path);
    transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .brand-link:hover :global(.brand-logo),
  .brand-link:focus-visible :global(.brand-logo) {
    transform: translate(0.125rem, -0.0625rem);
  }

  @media (max-width: 24rem) {
    :global(.brand-logo) {
      width: 1.625rem;
    }
  }

  .nav-link::after {
    content: "";
    position: absolute;
    inset-block-end: 0.35rem;
    inset-inline: 0.75rem;
    height: 0.125rem;
    background: var(--color-path);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease-out;
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link[aria-current="page"]::after {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu[open] nav {
      animation: menu-enter 160ms ease-out both;
      transform-origin: top right;
    }
  }

  @keyframes menu-enter {
    from {
      opacity: 0;
      transform: translateY(-0.375rem) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>
