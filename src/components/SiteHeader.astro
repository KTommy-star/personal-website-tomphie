---
import { navigation } from "../data/navigation";
import { withBase } from "../lib/paths";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const base = import.meta.env.BASE_URL;

const normalize = (path: string) =>
  path.length > 1 ? path.replace(/\/+$/, "") : path;

const isCurrent = (href: string) => {
  const target = normalize(withBase(href, base));
  const current = normalize(pathname);
  return current === target || (target !== "/" && current.startsWith(`${target}/`));
};
---

<header class="site-header sticky top-0 z-40 border-b border-line bg-paper/95">
  <div class="mx-auto flex min-h-16 max-w-7xl items-center justify-between gap-6 px-5 sm:px-8 lg:px-10">
    <a
      class="inline-flex min-h-11 items-center text-base font-semibold no-underline"
      href={withBase("/", base)}
      aria-label="Tomphie 首页"
    >
      Tomphie
    </a>

    <nav class="hidden md:block" aria-label="主导航">
      <ul class="flex items-center gap-1" role="list">
        {navigation.map((item) => (
          <li>
            <a
              class:list={[
                "inline-flex min-h-11 items-center px-3 text-sm no-underline transition-colors duration-150",
                isCurrent(item.href)
                  ? "text-ink underline decoration-path decoration-2 underline-offset-8"
                  : "text-quiet hover:text-ink",
              ]}
              href={withBase(item.href, base)}
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <details class="relative md:hidden">
      <summary class="flex min-h-11 cursor-pointer list-none items-center px-2 text-sm font-medium">
        菜单
      </summary>
      <nav
        class="absolute right-0 top-full z-40 mt-2 w-52 border border-line bg-paper p-2 shadow-lg"
        aria-label="移动端主导航"
      >
        <ul class="grid gap-1" role="list">
          {navigation.map((item) => (
            <li>
              <a
                class:list={[
                  "flex min-h-11 items-center px-3 text-sm no-underline",
                  isCurrent(item.href) ? "bg-ink text-white" : "text-ink hover:bg-white",
                ]}
                href={withBase(item.href, base)}
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>
