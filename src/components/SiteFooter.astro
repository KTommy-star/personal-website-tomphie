---
import TomphieLogo from "./TomphieLogo.astro";
import { navigation } from "../data/navigation";
import { site } from "../data/site";
import { withBase } from "../lib/paths";

const base = import.meta.env.BASE_URL;
---

<footer class="border-t border-line py-10 sm:py-14">
  <div class="mx-auto grid max-w-7xl gap-8 px-5 sm:px-8 md:grid-cols-[1fr_auto] lg:px-10">
    <div>
      <a class="footer-brand inline-block text-ink" href={withBase("/", base)} aria-label={`${site.name} 首页`}>
        <TomphieLogo variant="wordmark" class="footer-logo" />
      </a>
      <p class="mt-3 max-w-xl text-sm text-quiet">{site.description}</p>
    </div>
    <nav aria-label="页尾导航">
      <ul class="flex max-w-md flex-wrap gap-x-5 gap-y-2" role="list">
        {navigation.map((item) => (
          <li>
            <a class="text-sm text-quiet underline-offset-4 hover:text-ink hover:underline" href={withBase(item.href, base)}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<style>
  :global(.footer-logo) {
    width: clamp(7rem, 10vw, 9rem);
  }

  .footer-brand {
    transition:
      color 160ms ease-out,
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .footer-brand:hover,
  .footer-brand:focus-visible {
    color: var(--color-path);
    transform: translateX(0.125rem);
  }
</style>
