---
import { navigation } from "../data/navigation";
import { site } from "../data/site";
import { withBase } from "../lib/paths";

const base = import.meta.env.BASE_URL;
---

<footer class="border-t border-line py-10 sm:py-14">
  <div class="mx-auto grid max-w-7xl gap-8 px-5 sm:px-8 md:grid-cols-[1fr_auto] lg:px-10">
    <div>
      <p class="font-semibold">{site.name}</p>
      <p class="mt-2 max-w-xl text-sm text-quiet">{site.description}</p>
    </div>
    <nav aria-label="页尾导航">
      <ul class="flex max-w-md flex-wrap gap-x-5 gap-y-2" role="list">
        {navigation.map((item) => (
          <li>
            <a class="text-sm text-quiet underline-offset-4 hover:text-ink hover:underline" href={withBase(item.href, base)}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>
