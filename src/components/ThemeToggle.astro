<button
  class="theme-toggle"
  type="button"
  aria-label="切换到深色模式"
  aria-pressed="false"
  data-theme-toggle
>
  <svg class="theme-sun" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
  <svg class="theme-moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 019.5 4a8.5 8.5 0 1010.5 10.5Z"/></svg>
</button>

<script>
  import {
    THEME_STORAGE_KEY,
    nextTheme,
    resolveTheme,
    type Theme,
  } from "../lib/theme";

  const root = document.documentElement;
  const query = window.matchMedia("(prefers-color-scheme: dark)");

  const readStored = () => {
    try {
      return window.localStorage.getItem(THEME_STORAGE_KEY);
    } catch {
      return null;
    }
  };

  const setTheme = (theme: Theme, persist = false) => {
    root.dataset.theme = theme;
    root.style.colorScheme = theme;
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute("content", theme === "dark" ? "#081C27" : "#EDF4F3");

    document
      .querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")
      .forEach((button) => {
        button.ariaPressed = String(theme === "dark");
        button.ariaLabel = theme === "dark" ? "切换到浅色模式" : "切换到深色模式";
      });

    if (persist) {
      try {
        window.localStorage.setItem(THEME_STORAGE_KEY, theme);
      } catch {
        // The current-page theme still works when storage is unavailable.
      }
    }
  };

  const initial = resolveTheme(root.dataset.theme ?? readStored(), query.matches);
  setTheme(initial);

  document
    .querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")
    .forEach((button) => {
      button.addEventListener("click", () => {
        const current: Theme = root.dataset.theme === "dark" ? "dark" : "light";
        setTheme(nextTheme(current), true);
      });
    });

  query.addEventListener("change", (event) => {
    if (readStored() === null) setTheme(resolveTheme(null, event.matches));
  });

  window.requestAnimationFrame(() => root.classList.add("theme-ready"));
</script>

<style>
  .theme-toggle {
    position: relative;
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 9999px;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      border-color 180ms ease-out,
      background-color 180ms ease-out,
      color 180ms ease-out,
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .theme-sun, .theme-moon { position: absolute; transition: opacity 350ms ease, transform 550ms cubic-bezier(.22,1,.36,1); }
  .theme-moon { opacity: 0; transform: rotate(-60deg) scale(.5); }
  .theme-toggle[aria-pressed="true"] .theme-sun { opacity: 0; transform: rotate(60deg) scale(.5); }
  .theme-toggle[aria-pressed="true"] .theme-moon { opacity: 1; transform: rotate(0) scale(1); }

  @media (hover: hover) {
    .theme-toggle:hover {
      border-color: var(--color-path);
      background: color-mix(in srgb, var(--color-path) 10%, transparent);
      color: var(--color-path);
      transform: translateY(-0.0625rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-sun, .theme-moon {
      transition: none;
    }
  }
</style>
