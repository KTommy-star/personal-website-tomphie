<button
  class="theme-toggle"
  type="button"
  aria-label="切换到深色模式"
  aria-pressed="false"
  data-theme-toggle
>
  <span class="theme-toggle__symbol" aria-hidden="true">
    <span class="theme-toggle__orb"></span>
  </span>
</button>

<script>
  import {
    THEME_STORAGE_KEY,
    nextTheme,
    resolveTheme,
    type Theme,
  } from "../lib/theme";

  const root = document.documentElement;
  const query = window.matchMedia("(prefers-color-scheme: dark)");

  const readStored = () => {
    try {
      return window.localStorage.getItem(THEME_STORAGE_KEY);
    } catch {
      return null;
    }
  };

  const setTheme = (theme: Theme, persist = false) => {
    root.dataset.theme = theme;
    root.style.colorScheme = theme;
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute("content", theme === "dark" ? "#0D1015" : "#F4F7FA");

    document
      .querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")
      .forEach((button) => {
        button.ariaPressed = String(theme === "dark");
        button.ariaLabel = theme === "dark" ? "切换到浅色模式" : "切换到深色模式";
      });

    if (persist) {
      try {
        window.localStorage.setItem(THEME_STORAGE_KEY, theme);
      } catch {
        // The current-page theme still works when storage is unavailable.
      }
    }
  };

  const initial = resolveTheme(root.dataset.theme ?? readStored(), query.matches);
  setTheme(initial);

  document
    .querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")
    .forEach((button) => {
      button.addEventListener("click", () => {
        const current: Theme = root.dataset.theme === "dark" ? "dark" : "light";
        setTheme(nextTheme(current), true);
      });
    });

  query.addEventListener("change", (event) => {
    if (readStored() === null) setTheme(resolveTheme(null, event.matches));
  });

  window.requestAnimationFrame(() => root.classList.add("theme-ready"));
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
    border-radius: 9999px;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      border-color 180ms ease-out,
      background-color 180ms ease-out,
      color 180ms ease-out,
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .theme-toggle__symbol {
    display: inline-flex;
    width: 1.35rem;
    height: 0.8rem;
    align-items: center;
    padding: 0.125rem;
    border: 1px solid currentColor;
    border-radius: 9999px;
  }

  .theme-toggle__orb {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: currentColor;
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .theme-toggle[aria-pressed="true"] .theme-toggle__orb {
    transform: translateX(0.55rem);
  }

  @media (hover: hover) {
    .theme-toggle:hover {
      border-color: var(--color-path);
      background: color-mix(in srgb, var(--color-path) 10%, transparent);
      color: var(--color-path);
      transform: translateY(-0.0625rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-toggle__orb {
      transition: none;
    }
  }
</style>
